# ==============================================================================
# Support Docs Copilot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env) and populate the values.
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# ---------- Application ----------
APP_ENV=development                      # development | production
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
API_BASE_PATH=/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Neon PostgreSQL (pgvector) ----------
# Primary database on Neon with pgvector extension enabled.
# For serverless / pooled connections, use the Neon pooled endpoint.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ---------- Google Gemini API ----------
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768                  # Must match selected embedding model output dimension
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=5

# ---------- Cloudflare R2 (S3-Compatible Object Storage) ----------
# Uploaded document source of truth; bucket must remain private.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=<private-bucket-name>
# R2_ENDPOINT_URL is optional; default is derived: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com

# ---------- Upload & Document Limits ----------
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=100
MAX_CHUNKS_PER_DOCUMENT=2000
MIN_EXTRACTED_CHARS=50
PROCESSING_TIMEOUT_MINUTES=15

# ---------- RAG Pipeline Parameters ----------
CHUNK_SIZE=1000                          # Characters per chunk
CHUNK_OVERLAP=150                        # Character overlap between chunks (< CHUNK_SIZE)
MIN_CHUNK_CHARS=100
TOP_K=5
SIMILARITY_THRESHOLD=0.65                # Cosine similarity cutoff (calibrated via evaluation)
MAX_CONTEXT_CHARS=6000
HISTORY_MESSAGES=6
MAX_QUESTION_CHARS=2000

# ---------- In-Process Rate Limiting ----------
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ---------- Google Sign-In (OAuth2) ----------
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# ---------- Frontend (Public values only, no secrets!) ----------
# Configured in frontend/.env
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
